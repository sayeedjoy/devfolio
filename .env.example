# Canonical site origin used to build absolute URLs for metadata,
# sitemap, and RSS. Required for production builds OFF Vercel.
#
# On Vercel this is optional — VERCEL_PROJECT_PRODUCTION_URL is used
# automatically (see lib/site.ts). Set this for any other host, or to
# override the detected origin. No trailing slash; protocol required.
#
# Plain (non-NEXT_PUBLIC) env var so it is never inlined into the
# client bundle.
SITE_URL=https://your-domain.com
